rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return isSignedIn()
          && (data.laveurId == request.auth.uid || data.clientId == request.auth.uid);
    }

    function isPublished(data) {
      return data.published == true;
    }
    
    /// --- Supers Functions ---
    // function isSuper() {
    //   return isSignedIn()
    //     && exists(/databases/$(database)/documents/supers/$(request.auth.uid))
    //     && get(/databases/$(database)/documents/supers/$(request.auth.uid)).data.role == "super";
    // }
    
    match /supers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    function isSuperUser() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/supers/$(request.auth.uid));
    }

    function isValidSupplierRange(range) {
      return range.keys().hasOnly(['min', 'max', 'price'])
          && range.keys().hasAll(['min', 'max', 'price'])
          && range.min is number
          && range.max is number
          && range.price is number
          && range.min >= 0
          && range.max > range.min
          && range.price >= 0;
    }

    function isValidSupplierShipping(shipping) {
      return shipping is map
          && (
            (
              shipping.keys().hasOnly(['type', 'price'])
              && shipping.keys().hasAll(['type', 'price'])
              && shipping.type == 'fixed'
              && shipping.price is number
              && shipping.price >= 0
            )
            || (
              shipping.keys().hasOnly(['type', 'ranges'])
              && shipping.keys().hasAll(['type', 'ranges'])
              && (shipping.type == 'amount' || shipping.type == 'weight')
              && shipping.ranges is list
              && shipping.ranges.size() == 3
              && isValidSupplierRange(shipping.ranges[0])
              && isValidSupplierRange(shipping.ranges[1])
              && isValidSupplierRange(shipping.ranges[2])
            )
          );
    }

    function isValidSupplier(data) {
      return data.keys().hasOnly(['id', 'name', 'shipping', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['id', 'name', 'shipping', 'createdAt', 'updatedAt'])
          && data.id is string
          && data.id.size() > 0
          && data.id.size() <= 80
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 120
          && isValidSupplierShipping(data.shipping)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /suppliers/{supplierId} {
      allow read: if isSuperUser();
      allow create: if isSuperUser()
          && request.resource.data.id == supplierId
          && isValidSupplier(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      allow update: if isSuperUser()
          && request.resource.data.id == supplierId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && isValidSupplier(request.resource.data);
      allow delete: if false;
    }

    // ---- Profil laveur: privé pour le pro.
    match /laveurs/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /services/{serviceId} {
        allow create: if isOwner(userId)
            && request.resource.data.laveurId == userId;
        allow read: if isOwner(userId) || isPublished(resource.data);
        allow update: if isOwner(userId)
          && resource.data.laveurId == userId
          && request.resource.data.laveurId == userId;
        allow delete: if isOwner(userId)
          && resource.data.laveurId == userId;
      }

      match /addons/{addonId} {
        allow create: if isOwner(userId)
            && request.resource.data.laveurId == userId;
        allow read: if isOwner(userId) || isPublished(resource.data);
        allow update: if isOwner(userId)
          && resource.data.laveurId == userId
          && request.resource.data.laveurId == userId;
        allow delete: if isOwner(userId)
          && resource.data.laveurId == userId;
      }
    }

    // --- Profil public visible côté client, sans email ni téléphone.
    match /pub_laveurs/{userId} {
      allow read: if resource.data.isBanned != true;
      allow write: if isOwner(userId);
    }

    // --- Compatibilité legacy pendant migration.
    match /users/{userId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    // --- Réservations lisibles par le laveur concerné et le client concerné.
    match /reservations/{reservationId} {
      allow create: if isParticipant(request.resource.data);
      allow read, update, delete: if isParticipant(resource.data);
    }

    // --- Paiements lisibles par le laveur concerné et le client concerné.
    match /payments/{paymentId} {
      allow create: if isParticipant(request.resource.data);
      allow read, update, delete: if isParticipant(resource.data);
    }

    // --- Produits visibles côté client seulement s'ils sont publiés.
    match /products/{productId} {
      allow create: if isSignedIn()
          && request.resource.data.laveurId == request.auth.uid;
      allow read: if resource.data.published == true
          || (isSignedIn() && resource.data.laveurId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.laveurId == request.auth.uid
        && request.resource.data.laveurId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.laveurId == request.auth.uid;
    }
  }
}
